// Program to demonstrate an array of unions
#include <iostream>
using namespace std;

union Data {
    int value;
    float decimal;
};

int main() {
    Data d[3];
    d[0].value = 10;
    d[1].value = 20;
    d[2].value = 30;

    for (int i = 0; i < 3; i++)
        cout << d[i].value << " ";

    return 0;
}
